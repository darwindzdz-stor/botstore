BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
WEBAPP_URL=https://YOUR-DOMAIN.example/
PORT=8787
# Bind locally by default. Use 0.0.0.0 only behind a trusted HTTPS reverse proxy.
HOST=127.0.0.1
ADMIN_TELEGRAM_IDS=123456789
NODE_ENV=production
DB_FILE=./data/botstore.sqlite
TELEGRAM_AUTH_MAX_AGE=3600
TRUST_PROXY=0
# Optional comma-separated origins in addition to same-origin and Telegram web clients.
ALLOWED_ORIGINS=

# Google IMA / video ads for the Telegram Mini App. Keep disabled until a valid VAST tag is configured.
GOOGLE_IMA_ENABLED=0
GOOGLE_IMA_EVERY_OPEN=1
GOOGLE_IMA_VAST_TAG=

# Retention / backup housekeeping
EVENT_RETENTION_DAYS=90
BACKUP_RETENTION=10

# Short-lived server session issued after Telegram Mini App authentication.
SESSION_TTL=43200
